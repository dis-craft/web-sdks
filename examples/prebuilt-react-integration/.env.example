# Server-only configuration for the Google Meet + WhatsApp class flow.
# Do NOT expose these as VITE_* variables.

APP_BASE_URL=https://your-domain.example
APP_TIMEZONE=Asia/Kolkata

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_COOKIE_SECRET=replace-with-a-long-random-secret

# Signed academy join links
JOIN_LINK_SECRET=replace-with-a-second-long-random-secret

# Google Cloud OAuth 2.0 web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/google/callback

# WhatsApp Cloud API
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=class_invite
WHATSAPP_TEMPLATE_LANGUAGE=en_US
